# Secondary (pbx-sec) — priority 240, state BACKUP
# state BACKUP + nopreempt on both nodes (including PRI).
global_defs {
        enable_script_security
        script_user www-data
}

vrrp_script check_fs_profiles {
        script "/etc/keepalived/ka-status.sh"
        interval 5
        # fall must cover FreeSWITCH cold start; with grace (90s) fall=2 is usable,
        # but fall>=6 is safer if grace stamp is missing.
        fall 6
        rise 3
}

vrrp_sync_group VG1 {
        group {
                VIP_INTERNAL
                VIP_SBC
        }

        track_script {
              check_fs_profiles
        }
}

vrrp_instance VIP_INTERNAL {
        state BACKUP
        interface ens192

        virtual_router_id 50
        priority 240
        nopreempt
        advert_int 1
        authentication {
                auth_type AH
                auth_pass CHANGE_ME
        }

        unicast_src_ip 192.168.32.192
        unicast_peer {
                192.168.32.191/24
        }

        notify "/etc/keepalived/ka-notify.sh"

        virtual_ipaddress {
                192.168.32.190/24 label ens192:1
        }
}

vrrp_instance VIP_SBC {
        state BACKUP
        interface ens224

        virtual_router_id 60
        priority 240
        nopreempt
        advert_int 1
        authentication {
                auth_type AH
                auth_pass CHANGE_ME
        }

        unicast_src_ip 172.25.144.52
        unicast_peer {
                172.25.144.51/24
        }
        virtual_ipaddress {
                172.25.144.50/24 label ens224:1
        }
}
